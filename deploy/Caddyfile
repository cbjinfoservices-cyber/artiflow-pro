# ArtiFlow-pro — site et espace artisan (application React, fichiers statiques).
(site) {
	root * /srv
	encode zstd gzip
	# Cartes de code source (.map) et fichiers cachés : jamais servis (ils exposeraient le code complet).
	# (Deux blocs « handle » exclusifs : sinon le renvoi vers index.html passerait avant la règle.)
	@prive path *.map /.env* /.git/*
	handle @prive {
		respond 404
	}
	# Les fichiers de /assets portent une empreinte dans leur nom : mise en cache longue.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	# Images et icônes du dossier public (noms sans empreinte) : cache d'un mois.
	@images path /images/* /favicon-32.png /apple-touch-icon.png
	header @images Cache-Control "public, max-age=2592000"
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		# Complète la CSP d'index.html : frame-ancestors n'est pris en compte que dans un en-tête.
		Content-Security-Policy "frame-ancestors 'self'"
		# Micro autorisé pour l'agent vocal ; caméra, position et paiement navigateur coupés.
		Permissions-Policy "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		-Server
	}
	# Application monopage : toute adresse inconnue renvoie index.html (le routeur React prend le relais).
	handle {
		try_files {path} /index.html
		file_server
	}
}

artiflow-pro.com {
	import site
}

# Toutes les variantes (www, http) vont directement à https://artiflow-pro.com en une
# seule redirection, au lieu de passer d'abord par https://www puis par le domaine nu.
www.artiflow-pro.com, http://www.artiflow-pro.com, http://artiflow-pro.com {
	redir https://artiflow-pro.com{uri} permanent
}

# Accès direct par l'adresse IP : renvoyé vers le domaine en HTTPS (plus de site servi en clair).
:80 {
	redir https://artiflow-pro.com{uri} permanent
}
